{
  "name": "media-downloader-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Landing page for Media Downloader, served as static assets from Cloudflare Workers",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/fetch-release.mjs && node scripts/generate-shared-image.mjs && astro build",
    "preview": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "check": "astro check",
    "sync:release": "node scripts/fetch-release.mjs",
    "shared-image": "node scripts/generate-shared-image.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/familjen-grotesk": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "astro": "7.4.7",
    "satori": "0.63.2",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@tailwindcss/vite": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "4.156.1"
  },
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22.12.0"
  }
}
