---
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import DownloadSection from '../components/DownloadSection.astro'
import Faq from '../components/Faq.astro'
import { faqs, jsonLdOrganization, platforms, site } from '../data/site'
import { asset, release } from '../lib/release'
import homeShot from '../assets/app-home-main.png'
import queueShot from '../assets/app-queue.png'
import converterShot from '../assets/app-converter.png'
import libraryShot from '../assets/app-library.png'

const siteUrl = Astro.site ?? new URL('https://media-downloader-landing.luisfrm.workers.dev')
const windows = asset('windowsSetup')
const linux = asset('linuxAppImage')
const macos = asset('macosDmg')

const title = 'Media Downloader: descargá videos y audio de YouTube, X, TikTok e Instagram'
const description = site.description

const field = [
  'x.com/DonShelby_/status/2116216248  mp4 1280x1590  13.2 MB',
  'youtube.com/watch  mp4 3840x2160  vtt es',
  'tiktok.com/@  mp4 1080x1920  sin marca de agua',
  'instagram.com/reel  mp4 1080x1350  carrusel',
  'facebook.com/watch  mp4 1280x720  reels',
  'mp3 320  flac  m4a  wav  opus',
  'windows-x64  70.6 MB',
  'linux-x64  142 MB',
  'macos-arm64  37.9 MB',
  'x.com/DonShelby_/status/2116216248  mp4 1280x1590  13.2 MB',
  'youtube.com/watch  mp4 3840x2160  vtt es',
  'tiktok.com/@  mp4 1080x1920  sin marca de agua',
  'instagram.com/reel  mp4 1080x1350  carrusel',
  'facebook.com/watch  mp4 1280x720  reels',
  'mp3 320  flac  m4a  wav  opus',
  'windows-x64  70.6 MB',
  'linux-x64  142 MB',
  'macos-arm64  37.9 MB',
].join('\n')

const softwareApp = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.name,
  description: site.description,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Windows 10, Windows 11, Linux, macOS',
  softwareVersion: release.version,
  downloadUrl: windows?.url ?? site.latestRelease,
  installUrl: site.latestRelease,
  softwareHelp: site.installDocs,
  license: 'https://opensource.org/license/mit',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: jsonLdOrganization,
  sameAs: [site.repo],
  screenshot: new URL('/shared-image.png', siteUrl).href,
}

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: new URL('/', siteUrl).href,
  inLanguage: 'es',
  description: site.description,
}

const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
}
---

<Base title={title} description={description} jsonLd={[softwareApp, website, faqPage]}>
  <section class="hero-section">
    <div class="hero">
      <div class="container-page hero-grid">
      <div class="hero-copy">
        <h1>Bajá el video<br />o el audio.</h1>
        <p class="lede mt-5">
          YouTube, X, TikTok, Instagram y Facebook. Sin cuenta y sin subir enlaces.
        </p>

        <div class="hero-actions">
          {
            windows && (
              <a class="key key--primary os-key" data-os="windows" href={windows.url}>
                Windows
              </a>
            )
          }
          {
            linux && (
              <a class="key os-key" data-os="linux" href={linux.url}>
                Linux
              </a>
            )
          }
          {
            macos && (
              <a class="key os-key" data-os="macos" href={macos.url}>
                macOS
              </a>
            )
          }
        </div>

        <div class="hero-meta">
          <span>Instaladores con yt-dlp y ffmpeg</span>
          <span>Windows 10/11, Linux x64, macOS arm64</span>
        </div>
      </div>

      <div class="hero-visual">
        <figure class="figure relative z-10">
          <div class="cut screenshot-frame">
            <Image
              src={queueShot}
              alt="Cola de Media Downloader con una descarga de X completada y su tamaño."
              widths={[480, 720, 960]}
              sizes="(min-width: 1024px) 600px, 100vw"
              format="webp"
              quality={82}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="screenshot"
            />
          </div>
          <figcaption>La cola real, con una descarga de X completada.</figcaption>
        </figure>
      </div>
    </div>
  </div>

    <div class="field-band" aria-hidden="true">
      <div class="container-page">
        <pre class="field">{field}</pre>
      </div>
    </div>
  </section>

  <section id="producto" class="section--l">
    <div class="container-page">
      <div class="split">
        <div class="split__copy">
          <h2>De un enlace a un archivo.</h2>
          <p class="lede mt-4">
            Elegí resolución, formato y subtítulos. La cola hace el resto.
          </p>
        </div>
        <div class="split__body">
          <div class="mapping graphite" aria-label="Ejemplo real de una descarga de X">
            <div class="mapping__pane">
              <p class="label text-graphite-muted">Entrada</p>
              <p class="mono mt-3 break-all text-sm text-graphite-ink">
                https://x.com/DonShelby_/status/2116216248291754237
              </p>
              <p class="mt-3 text-sm text-graphite-muted">X, 1280 x 1590</p>
            </div>
            <div class="mapping__pane">
              <p class="label text-graphite-muted">Salida</p>
              <p class="mt-3 font-display text-title text-graphite-ink">Muy Zidanesca esta acción.</p>
              <p class="mt-2 text-sm text-graphite-muted">Don Shelby, X</p>
              <p class="mono mt-3 text-sm text-accent-2">MP4, 13.2 MB</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <h2>El producto, en marcha.</h2>
      <p class="lede mt-4 max-w-[56ch]">
        La cola muestra progreso, pausa y archivos terminados. El conversor y la biblioteca están a un clic.
      </p>

      <div class="mt-8 grid grid-cols-1 gap-8 md:grid-cols-12">
        <figure class="figure md:col-span-8">
          <div class="cut screenshot-frame">
            <Image
              src={homeShot}
              alt="Pantalla de descarga de Media Downloader con la barra para pegar un enlace y el selector de calidad."
              widths={[560, 840, 1120]}
              sizes="(min-width: 1024px) 860px, 100vw"
              format="webp"
              quality={80}
              loading="lazy"
              decoding="async"
              class="screenshot"
            />
          </div>
          <figcaption>Pegá el enlace. La app detecta la plataforma y los formatos.</figcaption>
        </figure>

        <div class="flex flex-col gap-8 md:col-span-4">
          <figure class="figure">
            <div class="cut screenshot-frame">
              <Image
                src={converterShot}
                alt="Pantalla del conversor de Media Downloader con un archivo local listo para convertir."
                widths={[320, 480, 640]}
                sizes="(min-width: 1024px) 420px, 100vw"
                format="webp"
                quality={80}
                loading="lazy"
                decoding="async"
                class="screenshot"
              />
            </div>
            <figcaption>Conversor: cambia el contenedor sin volver a bajar.</figcaption>
          </figure>
          <figure class="figure">
            <div class="cut screenshot-frame">
              <Image
                src={libraryShot}
                alt="Biblioteca de Media Downloader con archivos descargados y su información."
                widths={[320, 480, 640]}
                sizes="(min-width: 1024px) 420px, 100vw"
                format="webp"
                quality={80}
                loading="lazy"
                decoding="async"
                class="screenshot"
              />
            </div>
            <figcaption>Biblioteca: todo lo descargado, en un solo lugar.</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section id="plataformas" class="section--s">
    <div class="container-page">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <h2>Cinco plataformas. Un flujo.</h2>
        <p class="lede max-w-[44ch]">
          La misma cola para YouTube, X, TikTok, Instagram y Facebook.
        </p>
      </div>

      <div class="mt-8 overflow-x-auto">
        <table class="ledger" aria-label="Plataformas soportadas">
          <thead>
            <tr>
              <th scope="col">Plataforma</th>
              <th scope="col">Qué baja</th>
              <th scope="col">Formatos</th>
            </tr>
          </thead>
          <tbody>
            {
              platforms.map((platform) => (
                <tr>
                  <th scope="row" class="font-display text-title font-medium text-ink">
                    {platform.name}
                  </th>
                  <td>{platform.what}</td>
                  <td class="mono">{platform.formats}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section--s bg-paper-2">
    <div class="container-page split">
      <div class="split__copy">
        <h2>La web no ve tus enlaces.</h2>
      </div>
      <div class="split__body">
        <p class="lede">
          Esta página es estática. La app descarga con yt-dlp en tu equipo; los ajustes y el historial se guardan ahí.
        </p>
        <p class="mt-4 text-sm text-muted">
          Sin cuentas, sin analytics y sin servidores propios.
          <a href="/privacidad">Cómo se manejan los datos</a>.
        </p>
      </div>
    </div>
  </section>

  <DownloadSection />

  <section id="preguntas" class="section">
    <div class="container-page split">
      <div class="split__copy">
        <h2>Antes de instalar.</h2>
        <p class="lede mt-4">Lo que conviene saber antes de bajar el instalador.</p>
        <p class="mt-4 text-sm">
          ¿Falta algo? <a href={site.repo} target="_blank" rel="noreferrer noopener">Abrí un issue en GitHub</a>.
        </p>
      </div>
      <div class="split__body">
        <Faq />
      </div>
    </div>
  </section>

  <section class="section--s">
    <div class="container-page flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <h2>Descargá. Pegá. Elegí.</h2>
        <p class="lede mt-4">Windows, Linux y macOS. Sin cuenta y sin configuración previa.</p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <a class="key key--primary" href="/descargar">Descargar</a>
        <a class="key key--ghost" href={site.repo} target="_blank" rel="noreferrer noopener">Ver el código</a>
      </div>
    </div>
  </section>
</Base>
