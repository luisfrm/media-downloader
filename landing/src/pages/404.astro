---
import Base from '../layouts/Base.astro'
---

<Base
  title="Página no encontrada | Media Downloader"
  description="La página que buscás no existe. Volvé al inicio o mirá las descargas."
  noindex
>
  <section class="section--l">
    <div class="container-page">
      <h1>Esta página no existe.</h1>
      <p class="lede mt-5 max-w-[48ch]">
        El enlace cambió. Probá desde el inicio o andá a las descargas.
      </p>
      <div class="hero-actions">
        <a href="/" class="key key--primary">Volver al inicio</a>
        <a href="/descargar" class="key key--ghost">Ir a descargas</a>
      </div>
      <p class="mono mt-8 text-sm text-muted">404</p>
    </div>
  </section>
</Base>
