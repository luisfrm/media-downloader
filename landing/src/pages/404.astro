---
import Base from '../layouts/Base.astro'
---

<Base
  title="Página no encontrada — Media Downloader"
  description="La página que buscás no existe. Volvé al inicio o mirá las descargas."
  noindex
>
  <section class="container-page flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-cyan/80">Error 404</p>
    <h1 class="mt-3 font-display text-[36px] font-semibold tracking-[-0.03em] text-ink md:text-[48px]">
      Esta página no existe.
    </h1>
    <p class="mt-3 max-w-[420px] text-[13px] leading-6 text-ink-3">
      Puede que el enlace haya cambiado. Probá desde el inicio o andá directo a las descargas.
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-2.5">
      <a href="/" class="inline-flex h-11 items-center rounded-md bg-cyan px-5 text-[13px] font-semibold text-[#06212a] transition-colors hover:bg-cyan-soft">
        Volver al inicio
      </a>
      <a href="/descargar" class="inline-flex h-11 items-center rounded-md border border-line px-4 text-[13px] text-ink-2 transition-colors hover:border-line-strong hover:text-ink">
        Ir a descargas
      </a>
    </div>
  </section>
</Base>
