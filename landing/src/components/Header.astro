---
import Logo from './Logo.astro'
import { nav, site } from '../data/site'
---

<header class="site-header">
  <div class="container-page site-header__inner">
    <a href="/" class="wordmark" aria-label="Media Downloader, ir al inicio">
      <Logo size={28} />
      <span>Media Downloader</span>
    </a>

    <div class="flex items-center gap-2">
      <details class="site-menu">
        <summary class="key key--ghost key--sm">Menú</summary>
        <nav class="site-menu__panel" aria-label="Secciones">
          {
            nav.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))
          }
          <a href={site.repo} target="_blank" rel="noreferrer noopener">GitHub</a>
        </nav>
      </details>

      <a href="/descargar" class="key key--primary key--sm">Descargar</a>
    </div>
  </div>
</header>
