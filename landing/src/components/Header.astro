---
import Logo from './Logo.astro'
import { nav, site } from '../data/site'
---

<header class="sticky top-0 z-50 border-b border-line bg-bg/85 backdrop-blur-md">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label="Media Downloader, ir al inicio">
      <Logo size={30} />
      <span class="font-display text-[15px] font-semibold tracking-[-0.01em] text-ink">Media Downloader</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Navegación principal">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="rounded-md px-3 py-2 text-[13px] text-ink-3 transition-colors duration-150 hover:bg-white/[0.04] hover:text-ink"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1.5">
      <a
        href={site.repo}
        target="_blank"
        rel="noreferrer noopener"
        class="grid size-9 place-items-center rounded-md text-ink-3 transition-colors duration-150 hover:bg-white/[0.05] hover:text-ink"
        aria-label="Media Downloader en GitHub"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path
            d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-1.93c-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.84 1.18 3.1 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
          ></path>
        </svg>
      </a>

      <a
        href="/descargar"
        class="inline-flex h-9 items-center gap-1.5 rounded-md bg-cyan px-3.5 text-[12.5px] font-semibold text-[#06212a] transition-colors duration-150 hover:bg-cyan-soft"
      >
        Descargar
      </a>

      <details class="group relative md:hidden">
        <summary
          class="grid size-9 cursor-pointer list-none place-items-center rounded-md text-ink-2 transition-colors hover:bg-white/[0.05] hover:text-ink [&::-webkit-details-marker]:hidden"
          aria-label="Abrir menú de navegación"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"
            stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <div
          class="absolute right-0 top-11 w-56 rounded-lg border border-line-strong bg-elevated p-1.5 shadow-card"
        >
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="block rounded-md px-3 py-3 text-[13px] text-ink-2 transition-colors hover:bg-white/[0.05] hover:text-ink"
              >
                {item.label}
              </a>
            ))
          }
          <a
            href={site.repo}
            target="_blank"
            rel="noreferrer noopener"
            class="block rounded-md px-3 py-2.5 text-[13px] text-ink-2 transition-colors hover:bg-white/[0.05] hover:text-ink"
          >
            GitHub
          </a>
        </div>
      </details>
    </div>
  </div>
</header>
