---
interface Props {
  size?: number
  class?: string
}

const { size = 30, class: className } = Astro.props
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  role="img"
  aria-label="Media Downloader"
>
  <defs>
    <linearGradient id="md-mark" x1="2" y1="1" x2="30" y2="31" gradientUnits="userSpaceOnUse">
      <stop stop-color="#7DEBFA"></stop>
      <stop offset="0.5" stop-color="#22D3EE"></stop>
      <stop offset="1" stop-color="#2563EB"></stop>
    </linearGradient>
  </defs>
  <rect width="32" height="32" rx="9" fill="url(#md-mark)"></rect>
  <rect x="0.6" y="0.6" width="30.8" height="30.8" rx="8.4" stroke="white" stroke-opacity="0.28" stroke-width="1.2"
  ></rect>
  <path d="M16 8.4v9.4" stroke="#04131C" stroke-width="2.7" stroke-linecap="round"></path>
  <path d="M11.3 13.9 16 18.6l4.7-4.7" stroke="#04131C" stroke-width="2.7" stroke-linecap="round" stroke-linejoin="round"
  ></path>
  <path d="M10.2 23.6h11.6" stroke="#04131C" stroke-opacity="0.5" stroke-width="2.7" stroke-linecap="round"></path>
</svg>
