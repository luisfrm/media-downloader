---
import { asset, formatBytes } from '../lib/release'
import { site, type Download } from '../data/site'

interface Props {
  item: Download
}

const { item } = Astro.props
const primary = asset(item.primary)
const secondary = item.secondary ? asset(item.secondary) : null
---

<article
  class="os-card relative flex flex-col rounded-xl border border-line bg-surface/55 p-5 transition-[border-color,box-shadow,transform] duration-200 hover:-translate-y-0.5 hover:border-line-strong"
  data-os={item.os}
>
  <div class="flex items-start justify-between gap-3">
    <span class="grid size-10 place-items-center rounded-lg border border-line bg-bg/60 text-ink-2">
      {
        item.icon === 'windows' && (
          <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor" aria-hidden="true">
            <path d="M2 3.5 10.5 2.2v9.1H2V3.5Zm10 8.2h10V1L12 2.45v9.25ZM2 12.3h8.5v9.5L2 20.5v-8.2Zm10 0h10V23l-10-1.4v-9.3Z" />
          </svg>
        )
      }
      {
        item.icon === 'apple' && (
          <svg viewBox="0 0 384 512" width="17" height="17" fill="currentColor" aria-hidden="true">
            <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z" />
          </svg>
        )
      }
      {
        item.icon === 'linux' && (
          <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m4 17 6-5-6-5" />
            <path d="M12 19h8" />
          </svg>
        )
      }
    </span>

    <span
      class="os-recommended-label hidden items-center gap-1.5 rounded-full border border-cyan/30 bg-cyan/[0.08] px-2 py-0.5 font-mono text-[9.5px] uppercase tracking-[0.08em] text-cyan"
      data-for={item.os}
    >
      <span class="size-1.5 rounded-full bg-cyan"></span>
      Tu sistema
    </span>
  </div>

  <h3 class="mt-4 font-display text-[17px] font-semibold text-ink">{item.name}</h3>
  <p class="mt-0.5 font-mono text-[10.5px] text-ink-3">{item.arch}</p>

  <div class="mt-5 flex flex-col gap-2">
    {
      primary ? (
        <a
          href={primary.url}
          class="flex h-11 items-center justify-between gap-3 rounded-md bg-cyan px-3.5 text-[12.5px] font-semibold text-[#06212a] transition-colors duration-150 hover:bg-cyan-soft"
        >
          <span class="flex items-center gap-2">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3v12" />
              <path d="m7 11 5 5 5-5" />
              <path d="M5 21h14" />
            </svg>
            {item.primaryLabel}
          </span>
          <span class="font-mono text-[10px] font-normal opacity-70">{formatBytes(primary.size)}</span>
        </a>
      ) : (
        <a
          href={site.latestRelease}
          class="flex h-11 items-center justify-center rounded-md border border-line text-[12.5px] font-medium text-ink-2 transition-colors hover:border-line-strong hover:text-ink"
        >
          Ver en GitHub
        </a>
      )
    }

    {
      secondary && (
        <a
          href={secondary.url}
          class="flex h-11 items-center justify-between gap-3 rounded-md border border-line px-3 text-[11.5px] text-ink-2 transition-colors duration-150 hover:border-line-strong hover:bg-white/[0.03] hover:text-ink"
        >
          <span>{item.secondaryLabel}</span>
          <span class="font-mono text-[10px] text-ink-3">{formatBytes(secondary.size)}</span>
        </a>
      )
    }
  </div>

  <p class="mt-auto pt-4 text-[10.5px] leading-4 text-ink-3">{item.note}</p>
</article>
