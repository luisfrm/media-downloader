---
import { downloads, site } from '../data/site'
import { asset, formatBytes, release, releaseDate } from '../lib/release'

interface Props {
  heading?: string
  intro?: string
  compact?: boolean
}

const {
  heading = 'Descargá para tu sistema.',
  intro = 'Instaladores para Windows, Linux y macOS. Incluyen yt-dlp y ffmpeg; no hace falta instalar nada más.',
  compact = false,
} = Astro.props
---

<section id="descargas" class:list={['bg-paper-3', compact ? 'section--s' : 'section']}>
  <div class="container-page">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-[560px]">
        <h2>{heading}</h2>
        <p class="lede mt-4">{intro}</p>
      </div>
      <p class="label flex flex-wrap gap-4 text-sm">
        <span class="mono text-ink-2">{release.tag}</span>
        <span>{releaseDate()}</span>
      </p>
    </div>

    <p
      data-mobile-note
      class="mt-6 items-start gap-3 border-l-2 border-accent bg-accent-wash px-4 py-3 text-sm text-ink-2"
    >
      Estás en un dispositivo móvil. Abrí esta página en tu computadora para descargar el instalador.
    </p>

    <div class="mt-8 overflow-x-auto">
      <table class="ledger" aria-label="Descargas por sistema">
        <thead>
          <tr>
            <th scope="col">Sistema</th>
            <th scope="col">Archivo</th>
            <th scope="col">Tamaño</th>
            <th scope="col">Acción</th>
          </tr>
        </thead>
        <tbody>
          {
            downloads.map((item) => {
              const primary = asset(item.primary)
              const secondary = item.secondary ? asset(item.secondary) : null
              return (
                <tr class="os-row" data-os={item.os}>
                  <td>
                    <span class="block font-display text-title text-ink">{item.name}</span>
                    <span class="mt-1 block text-sm text-muted">{item.arch}</span>
                    <span class="os-you mt-1 text-sm text-accent">tu sistema</span>
                  </td>
                  <td>
                    {primary ? (
                      <>
                        <a href={primary.url} class="inline-block font-display text-title text-ink no-underline hover:text-accent">
                          {item.primaryLabel}
                        </a>
                        <span class="mono mt-1 block break-all text-xs text-muted">{primary.name}</span>
                      </>
                    ) : (
                      <span class="text-sm text-muted">No disponible en este release.</span>
                    )}
                    {secondary ? (
                      <a href={secondary.url} class="mt-2 inline-block text-sm text-ink-2">
                        {item.secondaryLabel} <span class="mono text-muted">{formatBytes(secondary.size)}</span>
                      </a>
                    ) : null}
                    <p class="mt-2 max-w-[46ch] text-sm text-muted">{item.note}</p>
                  </td>
                  <td class="mono whitespace-nowrap text-ink-2">
                    {formatBytes(primary?.size)}
                    {secondary ? <span class="mt-1 block text-muted">{formatBytes(secondary.size)}</span> : null}
                  </td>
                  <td>
                    {primary ? (
                      <a href={primary.url} class="key key--ghost key--sm">Descargar</a>
                    ) : (
                      <a href={site.latestRelease} class="key key--ghost key--sm">Ver release</a>
                    )}
                  </td>
                </tr>
              )
            })
          }
        </tbody>
      </table>
    </div>

    <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
      {release.checksums ? (
        <a href={release.checksums} class="text-ink-2">SHA256SUMS.txt</a>
      ) : null}
      <a href={site.installDocs} class="text-ink-2" target="_blank" rel="noreferrer noopener">
        Guía de instalación
      </a>
      <a href={site.releases} class="text-ink-2" target="_blank" rel="noreferrer noopener">
        Todas las versiones
      </a>
    </div>
  </div>
</section>
