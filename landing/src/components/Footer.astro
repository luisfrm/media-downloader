---
import Logo from './Logo.astro'
import { site } from '../data/site'

const year = new Date().getFullYear()
---

<footer class="section--s hairline">
  <div class="container-page">
    <div class="footer-grid">
      <div class="footer-statement">
        <a href="/" class="wordmark" aria-label="Media Downloader, ir al inicio">
          <Logo size={28} />
          <span>Media Downloader</span>
        </a>
        <p class="text-display-s mt-8 max-w-[18ch] text-ink">Se queda en tu equipo.</p>
        <p class="mt-4 max-w-[52ch] text-sm text-muted">
          Open source y sin cuenta. La web es estática; la app descarga con yt-dlp y ffmpeg en tu computadora.
        </p>
      </div>

      <nav class="footer-links" aria-label="Recursos">
        <a href={site.repo} target="_blank" rel="noreferrer noopener">GitHub</a>
        <a href={site.releases} target="_blank" rel="noreferrer noopener">Releases</a>
        <a href={site.installDocs} target="_blank" rel="noreferrer noopener">Guía de instalación</a>
        <a href="/privacidad">Privacidad</a>
        <a href={`${site.repo}/blob/master/SECURITY.md`} target="_blank" rel="noreferrer noopener">Seguridad</a>
      </nav>
    </div>

    <div class="legal">
      <span>© {year} Media Downloader. Licencia MIT.</span>
      <span>Sitio estático servido desde Cloudflare Workers.</span>
    </div>
  </div>
</footer>
