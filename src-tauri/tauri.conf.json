{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Media Downloader",
  "version": "0.1.0",
  "identifier": "com.mediadownloader.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Media Downloader",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": false,
        "theme": "Dark",
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Descargá videos y audio de tus redes",
    "longDescription": "Media Downloader descarga videos, audio, miniaturas y subtítulos de YouTube, X, TikTok, Instagram y Facebook, con selección de resolución y formato."
  }
}
